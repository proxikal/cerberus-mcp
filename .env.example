# Cerberus Environment Variables Configuration
# Copy this file to .env and customize as needed

# Index Configuration
# Path to the Cerberus index database
# Default: ~/.cerberus/index.db or project-local cerberus.db
# CERBERUS_INDEX=/path/to/your/index.db

# Global Configuration File
# Path to cerberus.toml configuration file
# Default: Searches in standard locations (project root, ~/.cerberus/, etc.)
# CERBERUS_CONFIG=/path/to/cerberus.toml

# Session Timeout (seconds)
# How long before agent session times out
# Default: 3600 (1 hour)
# CERBERUS_SESSION_TIMEOUT=3600

# Session Tracking
# Enable/disable session tracking
# Values: true, false
# Default: true
# CERBERUS_TRACK_SESSION=true

# Disable Metrics Collection
# Set to true to disable metrics collection entirely
# Values: true, false, 1, yes
# Default: false
# CERBERUS_NO_TRACK=false

# Disable All Metrics
# Set to true to disable all metrics functionality
# Values: true, false, 1, yes
# Default: false
# CERBERUS_NO_METRICS=false

# Anchors Mode
# Control anchor attachment behavior
# Values: auto, always, never, smart
# Default: auto
# CERBERUS_ANCHORS=auto

# Compact Anchor Output
# Enable compact anchor formatting
# Values: 0, 1
# Default: 0
# CERBERUS_ANCHOR_COMPACT=0

# Logging Configuration
# Machine-readable mode (suppresses console output)
# Values: 0, 1, true, false, yes, no
# Default: 0
# CERBERUS_MACHINE_MODE=0

# File Logging
# Enable logging to file
# Values: 0, 1, true, false, yes, no
# Default: 0
# CERBERUS_FILE_LOGGING=0

# Token Limits (optional - see cerberus.toml.example for detailed configuration)
# Maximum tokens for a single tool response
# CERBERUS_TOKEN_LIMIT_MAX=50000
# Warning threshold for token usage
# CERBERUS_TOKEN_LIMIT_WARN=30000
# Enable/disable token safety limits
# CERBERUS_TOKEN_LIMIT_ENABLED=true

# Error Monitoring (optional - requires pip install cerberus-context[monitoring])
# Sentry DSN for error tracking
# Get this from your Sentry project settings
# SENTRY_DSN=https://your-key@sentry.io/your-project-id
# Sentry environment (e.g., production, staging, development)
# SENTRY_ENVIRONMENT=production
